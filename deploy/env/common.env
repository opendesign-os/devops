# 这些变量填在 Dokploy 的「项目共享变量」（Project → Shared Environment Variables）里，
# 服务内用 ${{project.变量名}} 引用。本文件只作为清单，不部署到服务器。
# 这里是全套地址与路径的唯一定义处，其余文件一律引用，不要写死。

# ===== 镜像仓库 =====
REGISTRY=registry.internal:5000
REGISTRY_NS=apps

# 公共镜像统一走 Zot 的代理缓存前缀，首次拉取时自动回源 Docker Hub，无需预先推送。
# 留空则各服务直连 Docker Hub（compose 里写的是 ${REGISTRY_CACHE:-docker.io}）
REGISTRY_CACHE=registry.internal:5000/docker

# ===== 机器 B 的数据根 =====
# 自研应用 bind mount 的根目录；第三方栈用命名卷，不走这里。原因见 docs/layout.md 第四节
APPDATA_ROOT=/srv/appdata

# ===== 通用运行参数 =====
TZ=Asia/Shanghai
LOG_MAX_SIZE=50m
LOG_MAX_FILE=3
