# Plane 变量清单。实际填写位置是 Dokploy 中 Plane 这个 Compose 服务的
# 「Environment」编辑器，Dokploy 会把内容写成 .env 放在 compose 同目录供插值。
# 公共变量用 ${{project.变量名}} 引用，不要重复定义。

# ============ 版本 ============
APP_RELEASE=v1.4.1

# 13 个镜像全部经此前缀从 Zot 拉取，onDemand 首次请求时自动回源 Docker Hub。
# 值在项目共享变量里定义，这里只引用
REGISTRY_CACHE=${{project.REGISTRY_CACHE}}

# ============ 访问地址（必改）============
# 由 Traefik 按域名路由到 proxy 服务，Plane 自身不占宿主机端口、不签证书
APP_DOMAIN=plane.example.com
SITE_ADDRESS=:80
WEB_URL=http://plane.example.com
CORS_ALLOWED_ORIGINS=http://plane.example.com

# ============ 证书与代理 ============
# 全站 HTTP，不签证书，这三项保持为空
CERT_EMAIL=
CERT_ACME_CA=
CERT_ACME_DNS=
TRUSTED_PROXIES=0.0.0.0/0
# 外部为 HTTP 时必须为 0，改用 HTTPS 后要同步改成 1，否则附件与图片加载失败
MINIO_ENDPOINT_SSL=0

# ============ 密钥（必改，用 openssl rand -hex 32 生成）============
SECRET_KEY=change-me-secret-key
LIVE_SERVER_SECRET_KEY=change-me-live-key

# ============ 数据库（密码必改，且须在首次启动前定好）============
POSTGRES_USER=plane
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=plane

# ============ 消息队列（密码必改）============
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=change-me-mq-password
RABBITMQ_VHOST=plane

# ============ 对象存储（密码必改）============
AWS_ACCESS_KEY_ID=plane-storage
AWS_SECRET_ACCESS_KEY=change-me-storage-key
AWS_S3_BUCKET_NAME=uploads
AWS_REGION=

# ============ 其他 ============
# 附件大小上限，单位字节，默认 5MB
FILE_SIZE_LIMIT=5242880
# API 进程数，8GB 内存以上可设为 3
GUNICORN_WORKERS=1
API_KEY_RATE_LIMIT=60/minute
AUTHENTICATION_RATE_LIMIT=10/minute
