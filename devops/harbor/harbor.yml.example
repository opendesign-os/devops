# Harbor 配置参考。实际使用时请复制离线包内的 harbor.yml.tmpl 为 harbor.yml，
# 再按本文件逐项修改，避免 _version 与安装包不匹配。
#
# 本方案 Harbor 只在内网提供 HTTP 服务：推镜像的是自己的机器 A，
# 两台机器的 daemon 都配了 insecure-registries，因此不需要域名和证书。

# 内网主机名，两台机器的 /etc/hosts 都指向机器 A 的内网 IP
hostname: harbor.internal

http:
  port: 8081

# 无外部代理，保持注释。
# 仅当将来要把 Harbor 暴露到公网（需自行加反向代理与证书）时才启用
# external_url: https://harbor.example.com

# TLS 由客户端 insecure-registries 豁免，保持注释
# https:
#   port: 443
#   certificate: /data/cert/fullchain.pem
#   private_key: /data/cert/privkey.pem

# 首次登录后立即在界面修改
harbor_admin_password: CHANGE_ME_admin_password

database:
  password: CHANGE_ME_db_password
  max_idle_conns: 10
  max_open_conns: 100
  conn_max_lifetime: 5m
  conn_max_idle_time: 0

# 镜像层与数据库文件落盘位置
data_volume: /srv/harbor

trivy:
  ignore_unfixed: false
  skip_update: false
  offline_scan: false
  security_check: vuln
  insecure: false

jobservice:
  # 4 核机器 3 个足够，数值越大内存占用越高
  max_job_workers: 3

notification:
  webhook_job_max_retry: 3

log:
  level: info
  local:
    rotate_count: 50
    rotate_size: 200M
    location: /var/log/harbor

# 保持安装包 harbor.yml.tmpl 里自带的值，不要手改
_version: 2.15.0
