# 这些变量填在 Dokploy 的「项目共享变量」（Project → Shared Environment Variables）里，
# 服务内用 ${{project.变量名}} 引用。本文件只作为清单，不部署到服务器。

# ===== 镜像仓库 =====
REGISTRY=harbor.internal:8081
REGISTRY_NS=apps

# 公共镜像统一走 Harbor 代理缓存项目。
# 留空则各服务直连 Docker Hub（compose 里写的是 ${REGISTRY_CACHE:-docker.io}）
REGISTRY_CACHE=harbor.internal:8081/dockerhub

# ===== 通用运行参数 =====
TZ=Asia/Shanghai
LOG_MAX_SIZE=50m
LOG_MAX_FILE=3
