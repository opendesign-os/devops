# 这些变量填在 Dokploy 对应服务的「Environment」里。本文件只作为清单，不部署到服务器。
# 公共变量用 ${{project.变量名}} 从项目共享变量引用，不要重复定义

APP_NAME=app-example
IMAGE_TAG=latest

REGISTRY=${{project.REGISTRY}}
REGISTRY_NS=${{project.REGISTRY_NS}}
TZ=${{project.TZ}}
LOG_MAX_SIZE=${{project.LOG_MAX_SIZE}}
LOG_MAX_FILE=${{project.LOG_MAX_FILE}}

# ===== 应用自身配置 =====
# DATABASE_URL=
# REDIS_URL=
